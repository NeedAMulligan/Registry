Windows Registry Editor Version 5.00

; -----------------------------------------------------------
; Disable News and Interests (Windows 10)
; -----------------------------------------------------------
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Feeds]
"ShellFeedsTaskbarViewMode"=dword:00000002

; -----------------------------------------------------------
; Disable Widgets (Windows 11)
; -----------------------------------------------------------
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Dsh]
"AllowNewsAndInterests"=dword:00000000

; Disable Windows Widgets (for all users)
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Windows Widgets]
"AllowWidgets"=dword:00000000
